{
  "name": "atlas-notetaker",
  "productName": "ATLAS Notetaker",
  "version": "0.2.0",
  "description": "Блокнот, в котором каждая заметка — территория на карте.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && node server/launch.js",
    "serve": "node server/server.js --no-idle-exit",
    "test": "node --test \"tests/*.test.js\"",
    "stage": "node build.mjs && node scripts/stage.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "install:browser": "node scripts/build-browser.mjs --install && node scripts/shortcut.mjs --browser",
    "icon": "node scripts/make-icon.mjs",
    "shortcut": "node scripts/shortcut.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@lezer/highlight": "^1.2.5"
  }
}
