{
  "name": "atlas-notetaker",
  "productName": "ATLAS Notetaker",
  "version": "0.19.1",
  "description": "Блокнот, в котором каждая заметка — территория на карте.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && node server/launch.js",
    "serve": "node server/server.js --no-idle-exit",
    "test": "node --test \"tests/*.test.js\"",
    "test:editor": "node build.mjs && node tests/visual-editor.browser.mjs",
    "stage": "node build.mjs && node scripts/stage.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "install:browser": "node scripts/build-browser.mjs --install && node scripts/shortcut.mjs --browser",
    "icon": "node scripts/make-icon.mjs",
    "shortcut": "node scripts/shortcut.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-mono": "0.4.2",
    "@expo-google-fonts/noto-serif": "0.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@lezer/highlight": "^1.2.5",
    "@pdf-lib/fontkit": "1.1.1",
    "diff": "9.0.0",
    "marked": "^18.1.2",
    "parse5": "8.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.9"
  }
}
